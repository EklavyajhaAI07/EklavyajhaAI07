# Production Worker variable (public site key; runtime configuration avoids a rebuild)
TURNSTILE_SITE_KEY=
# Optional build-time alias for static previews
PUBLIC_TURNSTILE_SITE_KEY=
# Production Worker secrets; local .env values are NOT uploaded automatically
TURNSTILE_SECRET=
TURNSTILE_HOSTNAMES=

# Web3Forms delivery (the access key is linked to the recipient inbox)
WEB3FORMS_ACCESS_KEY=

# Umami Analytics (Cloud Hobby Tier)
UMAMI_WEBSITE_ID=
