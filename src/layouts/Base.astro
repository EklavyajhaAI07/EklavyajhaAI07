---
import '../styles/tokens.css';
import '../styles/base.css';
import '../styles/animations.css';
import { site, identity, connect } from '../lib/content';

interface Props {
  title: string;
  description: string;
  canonicalPath?: string;
  ogImage?: string;
  ogImageAlt?: string;
  ogImageWidth?: number;
  ogImageHeight?: number;
  robots?: string;
  audience?: 'recruiter' | 'teams' | 'clients' | 'home';
}

const {
  title,
  description,
  canonicalPath = '',
  ogImage = '/assets/og/eklavyajha-social-preview.png',
  ogImageAlt = `Social preview for ${identity.name}, ${identity.roleLine}, based in Ahmedabad, India and a 5x Hackathon Finalist.`,
  ogImageWidth = 1733,
  ogImageHeight = 907,
  robots = 'index,follow',
  audience = 'home',
} = Astro.props;

const canonicalUrl = new URL(canonicalPath, site.siteUrl).href;
const fullOgImageUrl = new URL(ogImage, site.siteUrl).href;
const socialProfiles = connect.channels
  .filter((channel) => ['linkedin', 'github', 'x'].includes(channel.id) && 'url' in channel)
  .map((channel) => channel.url);

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "Person",
  "name": identity.name,
  "jobTitle": identity.roleLine,
  "description": `${identity.name} is an ${identity.roleLine.toLowerCase()} based in ${identity.location.city}, ${identity.location.region}, ${identity.location.country}. ${identity.supportingLine}.`,
  "url": site.siteUrl,
  "mainEntityOfPage": canonicalUrl,
  "image": new URL(identity.photo.src, site.siteUrl).href,
  "address": {
    "@type": "PostalAddress",
    "addressLocality": identity.location.city,
    "addressRegion": identity.location.region,
    "addressCountry": "IN"
  },
  "sameAs": socialProfiles,
  "award": "5x Hackathon Finalist",
  "knowsAbout": ["Full stack web development", "AI-powered applications"]
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="robots" content={robots} />
    <meta name="google-site-verification" content="pP37ynd8Y2uvdp7ORYWUig7xiha37z1aXjTTmPbBo2g" />
    <link rel="canonical" href={canonicalUrl} />

    <!-- Open Graph / Facebook -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={fullOgImageUrl} />
    <meta property="og:image:secure_url" content={fullOgImageUrl} />
    <meta property="og:image:type" content="image/png" />
    <meta property="og:image:width" content={String(ogImageWidth)} />
    <meta property="og:image:height" content={String(ogImageHeight)} />
    <meta property="og:image:alt" content={ogImageAlt} />
    <meta property="og:site_name" content={identity.name} />
    <meta property="og:locale" content="en_IN" />

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:url" content={canonicalUrl} />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={fullOgImageUrl} />
    <meta name="twitter:image:alt" content={ogImageAlt} />

    <!-- Google Fonts: Inter -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap"
      rel="stylesheet"
    />

    <!-- Structured Data (JSON-LD) -->
    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />

    <!-- Umami Analytics -->
    <script
      defer
      src="https://cloud.umami.is/script.js"
      data-website-id={import.meta.env.UMAMI_WEBSITE_ID || "d1268cb2-679b-4726-bfbb-6ea1232fd143"}
    ></script>
  </head>
  <body class={`audience-${audience}`}>
    <a class="skip-link" href="#main-content">Skip to main content</a>
    <slot />
  </body>
</html>
