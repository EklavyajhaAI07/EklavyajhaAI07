---
import Base from '../../layouts/Base.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import ConnectSection from '../../components/ConnectSection.astro';
import ProjectCard from '../../components/ProjectCard.astro';
import AnimationStage from '../../components/animation/AnimationStage.astro';
import StickyCtaBar from '../../components/StickyCtaBar.astro';
import QuickFacts from '../../components/QuickFacts.astro';
import {
  identity,
  copyDeck, 
  getProjectsForAudience,
  getSkillsForAudience,
  getProjectById,
  stats,
  hackathons,
  education,
  programs,
  community,
  journey,
  recruiterPage
} from '../../lib/content';
import type { ProjectData } from '../../lib/schema';

const title = `${identity.name} | AI-Powered Full Stack Developer Resume`;
const description = `AI-powered full stack developer and 5x hackathon finalist. See ${identity.name}'s projects, skills and certificates, and download his resume.`;
const projects = getProjectsForAudience('recruiter');
const skills = getSkillsForAudience('recruiter');

const categories = Array.from(new Set(skills.map(s => s.category)));

// Data bindings for Animation Stage
const featuredProjects = recruiterPage.animation.projects
  .map(id => getProjectById(id))
  .filter(Boolean) as ProjectData[];

const animStats = stats.filter(s => recruiterPage.animation.stats.includes(s.id));
const finalistStat = stats.find((stat) => stat.id === 'finalist-5x');
const eliteProgram = programs.find((program) => program.id === 'iitr-microsoft-elite-ai-ds');
const campusRole = community.find((item) => item.id === 'ecell-iitb-campus-ambassador');
const recruiterProofs = [
  finalistStat && `${finalistStat.value}${finalistStat.suffix ?? ''} ${finalistStat.label}`,
  `${education.degree}, ${education.university} (${education.startYear} to ${education.graduationYear})`,
  eliteProgram && `${eliteProgram.title} (${eliteProgram.start} to ${eliteProgram.end ?? 'present'}, ${eliteProgram.status.replace('-', ' ')})`,
  campusRole?.title,
].filter(Boolean) as string[];

---

<Base
  title={title}
  description={description}
  canonicalPath="/recruiter-hr/"
  audience="recruiter"
>
  <Header currentAudience="recruiter" />

  <main id="main-content">
    <!-- 25-Second GSAP Intro Animation System & Dark Stage -->
    <AnimationStage
      audience="recruiter"
      featuredProjects={featuredProjects}
      stats={animStats}
      journey={journey}
      heroTitle={`${identity.name} — ${identity.roleLine}`}
      headline={copyDeck.recruiter.headline[0]}
      endCard={copyDeck.recruiter.endCard[0]}
      primaryCta={{ label: "Download Resume (PDF)", href: "/assets/eklavya-jha-resume.pdf" }}
      secondaryCta={{ label: "Connect with Me", href: "#connect" }}
    />

    <section id="proof-strip-section" class="proof-strip">
      <div class="container">
        <ul class="proof-list">
          {recruiterProofs.map((proof) => <li>{proof}</li>)}
        </ul>
      </div>
    </section>

    <QuickFacts facts={[
      `${identity.name} is an ${identity.roleLine.toLowerCase()} in ${identity.location.city}, ${identity.location.region}, ${identity.location.country}; he is ${identity.supportingLine.toLowerCase()}.`,
      `He is a ${education.degree} student at ${education.university} (${education.startYear}–${education.graduationYear}).`,
      'He built Vasudha, a live accounting and management web app for a packaging trading business, and is a 5x Hackathon Finalist.',
    ]} />

    <section id="projects" class="page-section">
      <div class="container">
        <h2 class="section-title">Projects</h2>
        <div class="projects-grid">
          {projects.map(project => (
            <ProjectCard project={project} />
          ))}
        </div>
      </div>
    </section>

    <section id="skills" class="page-section bg-light">
      <div class="container">
        <h2 class="section-title">Skills</h2>
        <div class="skills-grid">
          {categories.map(category => {
            const catSkills = skills.filter(s => s.category === category);
            if (catSkills.length === 0) return null;
            return (
              <div class="skill-category card">
                <h3 class="category-title">{category}</h3>
                <ul class="skill-list">
                  {catSkills.map(skill => (
                    <li class="skill-item">
                      <div class="skill-header">
                        <span class="skill-name">{skill.name}</span>
                        <span class={`skill-level level-${skill.level}`}>{skill.level}</span>
                      </div>
                      <span class="skill-proof">Proof: {skill.proofProject}</span>
                    </li>
                  ))}
                </ul>
              </div>
            );
          })}
        </div>
      </div>
    </section>

    <section id="hackathons" class="page-section">
      <div class="container">
        <h2 class="section-title">Hackathons & Certificates</h2>
        <div class="hackathon-list card">
          {hackathons.map(h => (
            <div class="hackathon-item">
              <div class="hack-header">
                <strong>{h.event}</strong>
                {h.round && <span class="hack-round"> - {h.round}</span>}
                <span class={`badge ${h.result === 'finalist' ? 'badge-finalist' : 'badge-participant'}`}>
                  {h.result}
                </span>
              </div>
              {h.project && <div class="hack-project">Project: {getProjectById(h.project)?.title || h.project}</div>}
              {h.note && <div class="hack-note">{h.note}</div>}
              {h.proof && h.proof.publish && <a href={h.proof.url} target="_blank" rel="noopener" class="proof-link">View Certificate ↗</a>}
            </div>
          ))}
        </div>
      </div>
    </section>

    <section id="education" class="page-section bg-light">
      <div class="container">
        <h2 class="section-title">Education & Programs</h2>
        <div class="education-grid">
          <div class="edu-card card">
            <h3>{education.degree}</h3>
            <p class="edu-meta">{education.university}</p>
            <p class="edu-meta">{education.startYear} - {education.graduationYear} (Semester {education.currentSemester})</p>
          </div>
          {programs.map(p => (
            <div class="edu-card card">
              <h3>{p.title}</h3>
              <p class="edu-meta">{p.start} - {p.end} <span class="status-badge">{p.status}</span></p>
              {p.proof.publish && <a href={p.proof.url} target="_blank" rel="noopener" class="proof-link">View Proof ↗</a>}
            </div>
          ))}
        </div>
      </div>
    </section>

    <section id="journey" class="page-section">
      <div class="container">
        <h2 class="section-title">Journey</h2>
        <div class="timeline card">
          {journey.map(j => (
            <div class="timeline-item">
              <span class="timeline-date">{j.date}</span>
              <span class="timeline-label">{j.label}</span>
            </div>
          ))}
        </div>
      </div>
    </section>

    <ConnectSection currentAudience="recruiter" />
  </main>

  <StickyCtaBar currentAudience="recruiter" />
  <Footer />
</Base>

<style>
  .hero-stage {
    background-color: var(--stage-bg);
    color: var(--stage-text);
    padding: var(--space-12) 0 var(--space-16);
    position: relative;
    border-bottom: 1px solid rgba(255, 255, 255, 0.08);
  }

  .stage-inner {
    display: flex;
    flex-direction: column;
    gap: var(--space-10);
  }

  .hero-content {
    max-width: 820px;
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
  }

  .profile-photo {
    width: 120px;
    height: 120px;
    border-radius: var(--radius-card);
    background-color: #fff;
    padding: 4px;
    object-fit: cover;
    margin-bottom: var(--space-4);
  }

  .display-title {
    font-size: clamp(2rem, 5vw, 3.5rem);
    font-weight: 700;
    line-height: 1.15;
    letter-spacing: -0.02em;
    color: var(--stage-text);
  }

  .supporting-text {
    font-size: clamp(1.05rem, 2vw, 1.25rem);
    color: var(--stage-muted);
    line-height: 1.55;
    max-width: 680px;
  }

  .tags {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin: var(--space-2) 0;
  }

  .tag {
    font-size: 0.85rem;
    padding: 4px 12px;
    background: rgba(255, 255, 255, 0.05);
    border: 1px solid rgba(255, 255, 255, 0.1);
    border-radius: var(--radius-pill);
    color: var(--stage-muted);
  }

  .availability {
    font-size: 0.95rem;
    color: #10B981;
    font-weight: 500;
  }

  .hero-actions {
    display: flex;
    gap: var(--space-4);
    margin-top: var(--space-4);
  }

  .btn {
    padding: 10px 20px;
    border-radius: var(--radius-button);
    font-weight: 600;
    text-decoration: none;
    transition: all 0.2s ease;
  }

  .btn-primary {
    background-color: var(--accent-strong);
    color: #fff;
  }

  .btn-primary:hover {
    background-color: #173FB5;
  }

  .btn-secondary {
    background-color: rgba(255, 255, 255, 0.1);
    color: var(--stage-text);
  }

  .btn-secondary:hover {
    background-color: rgba(255, 255, 255, 0.2);
  }

  .proof-strip {
    background-color: var(--surface-bg);
    border-bottom: 1px solid var(--border);
    padding: var(--space-4) 0;
  }

  .proof-list {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-6);
    list-style: none;
    padding: 0;
    margin: 0;
    font-size: 0.9rem;
    font-weight: 500;
    color: var(--ink);
    justify-content: center;
  }

  .proof-list li {
    display: flex;
    align-items: center;
  }

  .proof-list li::before {
    content: "✓";
    color: var(--accent);
    margin-right: 8px;
    font-weight: 700;
  }

  .page-section {
    padding: var(--space-16) 0;
  }

  .bg-light {
    background-color: var(--surface-bg);
    border-top: 1px solid var(--border);
    border-bottom: 1px solid var(--border);
  }

  .section-title {
    font-size: clamp(1.75rem, 3vw, 2.25rem);
    font-weight: 700;
    color: var(--ink);
    margin-bottom: var(--space-8);
    line-height: 1.2;
  }

  .projects-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(320px, 1fr));
    gap: var(--space-6);
  }

  .card {
    background-color: var(--surface-card);
    border: 1px solid var(--border);
    border-radius: var(--radius-card);
    padding: var(--space-6);
  }

  .skills-grid, .education-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(300px, 1fr));
    gap: var(--space-6);
  }

  .category-title {
    font-size: 1.1rem;
    font-weight: 600;
    margin-bottom: var(--space-4);
    color: var(--ink);
  }

  .skill-list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
  }

  .skill-item {
    display: flex;
    flex-direction: column;
    gap: 4px;
    padding-bottom: var(--space-2);
    border-bottom: 1px solid rgba(0,0,0,0.05);
  }

  .skill-item:last-child {
    border-bottom: none;
  }

  .skill-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
  }

  .skill-name {
    font-weight: 600;
    font-size: 0.95rem;
  }

  .skill-level {
    font-size: 0.75rem;
    padding: 2px 8px;
    border-radius: var(--radius-pill);
    text-transform: capitalize;
    font-weight: 500;
  }

  .level-strong { background: #ECFDF5; color: #047857; }
  .level-working { background: #EFF6FF; color: #2563EB; }
  .level-learning { background: #FEF3C7; color: #92400E; }

  .skill-proof {
    font-size: 0.8rem;
    color: var(--ink-muted);
  }

  .hackathon-list {
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
  }

  .hackathon-item {
    padding-bottom: var(--space-4);
    border-bottom: 1px solid rgba(0,0,0,0.05);
  }

  .hackathon-item:last-child {
    border-bottom: none;
    padding-bottom: 0;
  }

  .hack-header {
    display: flex;
    align-items: center;
    gap: 8px;
    flex-wrap: wrap;
    margin-bottom: 4px;
  }

  .hack-round {
    color: var(--ink-muted);
    font-size: 0.9rem;
  }

  .badge {
    font-size: 0.75rem;
    padding: 2px 8px;
    border-radius: var(--radius-pill);
    font-weight: 600;
    text-transform: uppercase;
  }

  .badge-finalist { background: #FDF4FF; color: #A21CAF; border: 1px solid #F5D0FE; }
  .badge-participant { background: #F3F4F6; color: #4B5563; border: 1px solid #E5E7EB; }

  .hack-project {
    font-size: 0.9rem;
    color: var(--ink);
    margin-bottom: 6px;
  }

  .hack-note {
    margin-top: 4px;
    color: var(--ink-muted);
    font-size: 0.85rem;
  }

  .proof-link {
    font-size: 0.85rem;
    color: var(--accent);
    text-decoration: none;
    font-weight: 500;
  }
  .proof-link:hover {
    text-decoration: underline;
  }

  .edu-card h3 {
    font-size: 1.1rem;
    margin-bottom: 8px;
    color: var(--ink);
  }

  .edu-meta {
    font-size: 0.9rem;
    color: var(--ink-muted);
    margin-bottom: 4px;
  }

  .status-badge {
    font-size: 0.75rem;
    background: #F3F4F6;
    padding: 2px 6px;
    border-radius: var(--radius-pill);
    margin-left: 8px;
  }

  .timeline {
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
  }

  .timeline-item {
    display: grid;
    grid-template-columns: 120px 1fr;
    gap: var(--space-4);
    padding-bottom: var(--space-4);
    border-bottom: 1px solid rgba(0,0,0,0.05);
  }

  .timeline-item:last-child {
    border-bottom: none;
    padding-bottom: 0;
  }

  .timeline-date {
    font-weight: 600;
    color: var(--ink-muted);
    font-size: 0.9rem;
  }

  .timeline-label {
    font-weight: 500;
    color: var(--ink);
  }

  @media (max-width: 640px) {
    .timeline-item {
      grid-template-columns: 1fr;
      gap: 4px;
    }
  }
</style>
