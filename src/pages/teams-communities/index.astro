---
import Base from '../../layouts/Base.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import ConnectSection from '../../components/ConnectSection.astro';
import ProjectCard from '../../components/ProjectCard.astro';
import AnimationStage from '../../components/animation/AnimationStage.astro';
import StickyCtaBar from '../../components/StickyCtaBar.astro';
import QuickFacts from '../../components/QuickFacts.astro';
import {
  identity,
  copyDeck, 
  getProjectsForAudience,
  getProjectById,
  stats,
  hackathons,
  community,
  journey,
  teamsPage
} from '../../lib/content';
import type { ProjectData } from '../../lib/schema';

const title = `${identity.name} | 5x Hackathon Finalist, Campus Ambassador`;
const description = `5x hackathon finalist and E-Cell IIT Bombay Campus Ambassador. See ${identity.name}'s team builds, hackathon record and community work.`;
const projects = getProjectsForAudience('teams');

// Data bindings for Animation Stage
const featuredProjects = teamsPage.animation.projects
  .map(id => getProjectById(id))
  .filter(Boolean) as ProjectData[];

const animStats = stats.filter(s => teamsPage.animation.stats.includes(s.id));
const finalistStat = stats.find((stat) => stat.id === 'finalist-5x');
const highlightedCommunityIds = new Set([
  'ecell-iitb-campus-ambassador',
  'sih-coordinator',
  'founders-crew-core',
]);
const teamProofs = [
  finalistStat && `${finalistStat.value}${finalistStat.suffix ?? ''} ${finalistStat.label}`,
  ...community.filter((item) => highlightedCommunityIds.has(item.id)).map((item) => item.title),
].filter(Boolean) as string[];

---

<Base
  title={title}
  description={description}
  canonicalPath="/teams-communities/"
  audience="teams"
>
  <Header currentAudience="teams" />

  <main id="main-content">
    <!-- 25-Second GSAP Intro Animation System & Dark Stage -->
    <AnimationStage
      audience="teams"
      featuredProjects={featuredProjects}
      stats={animStats}
      journey={journey}
      heroTitle={`${identity.roleLine} & 5x Hackathon Finalist — ${identity.name}`}
      headline={copyDeck.teams.headline[0]}
      endCard={copyDeck.teams.endCard[0]}
      primaryCta={{ label: "Connect to Collaborate", href: "#connect" }}
      secondaryCta={{ label: "View Team Builds", href: "#projects" }}
    />

    <section id="proof-strip-section" class="proof-strip">
      <div class="container">
        <ul class="proof-list">
          {teamProofs.map((proof) => <li>{proof}</li>)}
        </ul>
      </div>
    </section>

    <QuickFacts facts={[
      `${identity.name} is an ${identity.roleLine.toLowerCase()} and a 5x Hackathon Finalist.`,
      'His community roles include Campus Ambassador, E-Cell IIT Bombay, and SIH Student Coordinator 2026.',
      'Dealflow360 is Team StackForge’s Odoo Hackathon 2026 Grand Finale build: an internal workspace and customer portal for quotes, approvals, inventory and billing.',
    ]} />

    <section id="projects" class="page-section">
      <div class="container">
        <h2 class="section-title">Team Builds</h2>
        <div class="projects-grid">
          {projects.map(project => (
            <ProjectCard project={project} />
          ))}
        </div>
      </div>
    </section>

    <section id="hackathons" class="page-section bg-light">
      <div class="container">
        <h2 class="section-title">Hackathon Record</h2>
        <p class="table-scroll-hint" id="hackathon-scroll-hint">Swipe or scroll horizontally to view every column.</p>
        <div class="table-container card" tabindex="0" aria-describedby="hackathon-scroll-hint">
          <table class="hackathon-table">
            <caption class="sr-only">Hackathon participation, projects, results, and certificate links</caption>
            <thead>
              <tr>
                <th scope="col">Event</th>
                <th scope="col">Project</th>
                <th scope="col">Result</th>
              </tr>
            </thead>
            <tbody>
              {hackathons.map(h => (
                <tr>
                  <td>{h.event} {h.round ? `(${h.round})` : ''}</td>
                  <td>
                    {h.project ? getProjectById(h.project)?.title || h.project : '-'}
                    {h.note && <div class="hack-note">{h.note}</div>}
                  </td>
                  <td>
                    <span class={`badge ${h.result === 'finalist' ? 'badge-finalist' : 'badge-participant'}`}>
                      {h.result}
                    </span>
                    {h.proof && h.proof.publish && (
                      <a href={h.proof.url} target="_blank" rel="noopener" class="proof-link">View Certificate ↗</a>
                    )}
                  </td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      </div>
    </section>

    <section id="community" class="page-section">
      <div class="container">
        <h2 class="section-title">Community & Leadership</h2>
        <div class="community-grid">
          {community.map(c => (
            <div class="community-card card">
              <h3 class="community-title">{c.title}</h3>
              <div class="community-meta">
                {c.type === 'role' && <span class="badge badge-role">Role</span>}
                {c.type === 'award' && <span class="badge badge-award">Award</span>}
                {c.type === 'participation' && <span class="badge badge-participation">Participation</span>}
                {c.date && <span class="date">{c.date}</span>}
              </div>
            </div>
          ))}
        </div>
      </div>
    </section>

    <section id="offer" class="page-section bg-light">
      <div class="container">
        <h2 class="section-title">Team Contributions</h2>
        <div class="offer-card card">
          <ul class="offer-list">
            {teamsPage.offer?.map(point => (
              <li>{point}</li>
            ))}
          </ul>
        </div>
      </div>
    </section>

    <ConnectSection currentAudience="teams" />
  </main>

  <StickyCtaBar currentAudience="teams" />
  <Footer />
</Base>

<style>
  /* Reuse hero and general styles from recruiter */
  .hero-stage {
    background-color: var(--stage-bg);
    color: var(--stage-text);
    padding: var(--space-12) 0 var(--space-16);
    position: relative;
    border-bottom: 1px solid rgba(255, 255, 255, 0.08);
  }

  .stage-inner {
    display: flex;
    flex-direction: column;
    gap: var(--space-10);
  }

  .hero-content {
    max-width: 820px;
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
  }

  .profile-photo {
    width: 120px;
    height: 120px;
    border-radius: var(--radius-card);
    background-color: #fff;
    padding: 4px;
    object-fit: cover;
    margin-bottom: var(--space-4);
  }

  .display-title {
    font-size: clamp(2rem, 5vw, 3.5rem);
    font-weight: 700;
    line-height: 1.15;
    letter-spacing: -0.02em;
    color: var(--stage-text);
  }

  .supporting-text {
    font-size: clamp(1.05rem, 2vw, 1.25rem);
    color: var(--stage-muted);
    line-height: 1.55;
    max-width: 680px;
  }

  .tags {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin: var(--space-2) 0;
  }

  .tag {
    font-size: 0.85rem;
    padding: 4px 12px;
    background: rgba(255, 255, 255, 0.05);
    border: 1px solid rgba(255, 255, 255, 0.1);
    border-radius: var(--radius-pill);
    color: var(--stage-muted);
  }

  .availability {
    font-size: 0.95rem;
    color: #10B981;
    font-weight: 500;
  }

  .hero-actions {
    display: flex;
    gap: var(--space-4);
    margin-top: var(--space-4);
  }

  .btn {
    padding: 10px 20px;
    border-radius: var(--radius-button);
    font-weight: 600;
    text-decoration: none;
    transition: all 0.2s ease;
  }

  .btn-primary { background-color: var(--accent-strong); color: #fff; }
  .btn-primary:hover { background-color: #173FB5; }
  .btn-secondary { background-color: rgba(255, 255, 255, 0.1); color: var(--stage-text); }
  .btn-secondary:hover { background-color: rgba(255, 255, 255, 0.2); }

  .proof-strip {
    background-color: var(--surface-bg);
    border-bottom: 1px solid var(--border);
    padding: var(--space-4) 0;
  }

  .proof-list {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-6);
    list-style: none;
    padding: 0;
    margin: 0;
    font-size: 0.9rem;
    font-weight: 500;
    color: var(--ink);
    justify-content: center;
  }

  .proof-list li {
    display: flex;
    align-items: center;
  }

  .proof-list li::before {
    content: "✓";
    color: var(--accent);
    margin-right: 8px;
    font-weight: 700;
  }

  .page-section { padding: var(--space-16) 0; }
  .bg-light { background-color: var(--surface-bg); border-top: 1px solid var(--border); border-bottom: 1px solid var(--border); }
  .section-title { font-size: clamp(1.75rem, 3vw, 2.25rem); font-weight: 700; color: var(--ink); margin-bottom: var(--space-8); line-height: 1.2; }
  
  .projects-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(320px, 1fr));
    gap: var(--space-6);
  }

  .card {
    background-color: var(--surface-card);
    border: 1px solid var(--border);
    border-radius: var(--radius-card);
    padding: var(--space-6);
  }

  .table-container {
    overflow-x: auto;
    padding: 0;
    scrollbar-gutter: stable;
    overscroll-behavior-inline: contain;
  }

  .table-container:focus-visible {
    outline: 2px solid var(--accent-strong);
    outline-offset: 3px;
  }

  .table-scroll-hint {
    display: none;
    margin: 0 0 var(--space-2);
    color: var(--ink-muted);
    font-size: 0.82rem;
  }

  .hackathon-table {
    width: 100%;
    border-collapse: collapse;
    min-width: 600px;
  }

  .hackathon-table th, .hackathon-table td {
    padding: var(--space-4) var(--space-6);
    text-align: left;
    border-bottom: 1px solid var(--border);
  }

  .hackathon-table th {
    background-color: #F9FAFB;
    font-weight: 600;
    color: var(--ink);
  }

  .hackathon-table tr:last-child td { border-bottom: none; }

  .badge {
    font-size: 0.75rem;
    padding: 2px 8px;
    border-radius: var(--radius-pill);
    font-weight: 600;
    text-transform: uppercase;
  }
  .badge-finalist { background: #FDF4FF; color: #A21CAF; border: 1px solid #F5D0FE; }
  .badge-participant { background: #F3F4F6; color: #4B5563; border: 1px solid #E5E7EB; }

  .hack-note {
    margin-top: 4px;
    color: var(--ink-muted);
    font-size: 0.82rem;
  }

  .proof-link {
    display: block;
    margin-top: 6px;
    color: var(--accent);
    font-size: 0.82rem;
    font-weight: 500;
    text-decoration: none;
  }

  .proof-link:hover { text-decoration: underline; }

  .community-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(300px, 1fr));
    gap: var(--space-6);
  }

  .community-title {
    font-size: 1.1rem;
    font-weight: 600;
    margin-bottom: 12px;
    color: var(--ink);
    line-height: 1.4;
  }

  .community-meta {
    display: flex;
    gap: 8px;
    align-items: center;
    margin-bottom: 8px;
  }

  .badge-role { background: #EFF6FF; color: #2563EB; border: 1px solid #BFDBFE; }
  .badge-award { background: #FEF3C7; color: #92400E; border: 1px solid #FDE68A; }
  .badge-participation { background: #F3F4F6; color: #4B5563; border: 1px solid #E5E7EB; }

  .date { font-size: 0.85rem; color: var(--ink-muted); }
  .offer-list {
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
    list-style: none;
    padding: 0;
    margin: 0;
  }

  .offer-list li {
    display: flex;
    align-items: flex-start;
    font-size: 1.05rem;
    color: var(--ink);
    line-height: 1.5;
  }

  .offer-list li::before {
    content: "→";
    color: var(--accent);
    margin-right: 12px;
    font-weight: 700;
  }

  @media (max-width: 640px) {
    .table-scroll-hint {
      display: block;
    }
  }
</style>
