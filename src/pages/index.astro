---
import Base from '../layouts/Base.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import ConnectSection from '../components/ConnectSection.astro';
import QuickFacts from '../components/QuickFacts.astro';
import { identity, homePage } from '../lib/content';

const title = `${identity.name} | ${identity.roleLine}`;
const description = `${identity.name} is an AI-Powered Full Stack Developer in Ahmedabad, India, building full-stack products and AI systems. Explore a live business app, AI projects and hackathon work.`;
---

<Base
  title={title}
  description={description}
  canonicalPath="/"
  audience="home"
>
  <Header currentAudience="home" />

  <main id="main-content">
    <!-- Hero / Stage with 3 Audience Cards -->
    <section class="home-stage" aria-labelledby="home-heading">
      <div class="stage-inner container">
        <div class="hero-topline">
          <div class="hero-intro">
            <div class="identity-badge">
              <span class="pulse-dot"></span>
              <span>Based in {identity.location.city}, {identity.location.country}</span>
            </div>
            <h1 id="home-heading" class="display-title">
              {identity.name}, <span class="highlight">{identity.roleLine}</span>
            </h1>
            <p class="supporting-text">
              {identity.supportingLine}. B.Tech CSE-AI student at Gandhinagar University; 5x Hackathon Finalist.
            </p>
          </div>

          <figure class="hero-portrait">
            <picture>
              <source srcset="/assets/eklavya-photo-320.avif" type="image/avif" />
              <source srcset="/assets/eklavya-photo-320.webp" type="image/webp" />
              <img
                src="/assets/eklavya-photo.png"
                alt="Portrait of Eklavya Jha wearing glasses and a dark blazer"
                width="320"
                height="399"
                loading="eager"
                fetchpriority="high"
                decoding="async"
              />
            </picture>
          </figure>
        </div>

        <!-- 3 Audience Route Cards -->
        <div class="audience-grid" role="region" aria-label="Choose your audience path">
          {homePage.cards.map((card) => (
            <a
              href={card.url}
              class="audience-card"
              id={`card-${card.id}`}
              data-umami-event="audience_selected"
              data-umami-event-audience={card.id}
            >
              <div class="card-top">
                <span class="path-badge">
                  {card.id === 'recruiter-hr' ? 'Resume & projects' : card.id === 'teams-communities' ? 'Hackathons & roles' : 'Business apps & prototypes'}
                </span>
                <span class="card-arrow" aria-hidden="true">→</span>
              </div>
              <h2 class="card-title">{card.title}</h2>
              <p class="card-desc">{card.description}</p>
            </a>
          ))}
        </div>
      </div>
    </section>

    <QuickFacts facts={[
      `${identity.name} is an ${identity.roleLine.toLowerCase()} based in ${identity.location.city}, ${identity.location.region}, ${identity.location.country}.`,
      `He is studying B.Tech CSE-AI at ${identity.college}.`,
      'He is a 5x Hackathon Finalist and built Vasudha, a live accounting and management web app for a packaging trading business.',
    ]} />

    <!-- Connect & Forms Section -->
    <ConnectSection currentAudience="home" />
  </main>

  <Footer />
</Base>

<style>
  .home-stage {
    background-color: var(--stage-bg);
    color: var(--stage-text);
    padding: var(--space-12) 0 var(--space-16);
    position: relative;
    border-bottom: 1px solid rgba(255, 255, 255, 0.08);
  }

  .stage-inner {
    display: flex;
    flex-direction: column;
    gap: var(--space-10);
  }

  .hero-topline {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(220px, 0.36fr);
    align-items: center;
    gap: clamp(var(--space-8), 6vw, var(--space-16));
  }

  .hero-intro {
    max-width: 820px;
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
  }

  .hero-portrait {
    justify-self: end;
    width: clamp(220px, 24vw, 310px);
    aspect-ratio: 0.84;
    margin: 0;
    padding: 8px;
    overflow: hidden;
    border: 1px solid rgba(147, 197, 253, 0.34);
    border-radius: 46% 46% var(--radius-card) var(--radius-card);
    background: linear-gradient(145deg, rgba(59, 130, 246, 0.22), rgba(255, 255, 255, 0.035) 58%);
    box-shadow: 0 24px 72px rgba(37, 99, 235, 0.18), 0 0 54px rgba(59, 130, 246, 0.11);
  }

  .hero-portrait picture,
  .hero-portrait img {
    display: block;
    width: 100%;
    height: 100%;
  }

  .hero-portrait img {
    object-fit: cover;
    object-position: center 24%;
    border-radius: inherit;
  }

  .identity-badge {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    font-size: 0.85rem;
    font-weight: 500;
    color: var(--stage-muted);
    background: rgba(255, 255, 255, 0.05);
    border: 1px solid rgba(255, 255, 255, 0.1);
    padding: 6px 14px;
    border-radius: var(--radius-pill);
    width: fit-content;
  }

  .pulse-dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background-color: #10B981;
    box-shadow: 0 0 8px #10B981;
  }

  .display-title {
    font-size: clamp(2rem, 5vw, 3.5rem);
    font-weight: 700;
    line-height: 1.15;
    letter-spacing: -0.02em;
    color: var(--stage-text);
  }

  .highlight {
    color: var(--accent);
  }

  .supporting-text {
    font-size: clamp(1.05rem, 2vw, 1.25rem);
    color: var(--stage-muted);
    line-height: 1.55;
    max-width: 680px;
  }

  .audience-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: var(--space-6);
  }

  .audience-card {
    background: rgba(255, 255, 255, 0.03);
    border: 1px solid rgba(255, 255, 255, 0.1);
    border-radius: var(--radius-card);
    padding: var(--space-8) var(--space-6);
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
    text-decoration: none;
    transition: all 0.25s ease;
    position: relative;
    overflow: hidden;
  }

  .audience-card::before {
    content: '';
    position: absolute;
    inset: 0;
    background: radial-gradient(circle at top right, rgba(59, 130, 246, 0.15), transparent 70%);
    opacity: 0;
    transition: opacity 0.3s ease;
  }

  .audience-card:hover {
    transform: translateY(-4px);
    border-color: var(--accent);
    background: rgba(255, 255, 255, 0.06);
    box-shadow: 0 12px 30px rgba(0, 0, 0, 0.3);
  }

  .audience-card:hover::before {
    opacity: 1;
  }

  .card-top {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: var(--space-2);
  }

  .path-badge {
    font-size: 0.75rem;
    font-weight: 600;
    color: var(--accent);
    text-transform: uppercase;
    letter-spacing: 0.06em;
  }

  .card-arrow {
    color: var(--stage-muted);
    font-size: 1.2rem;
    transition: transform 0.2s ease, color 0.2s ease;
  }

  .audience-card:hover .card-arrow {
    transform: translateX(4px);
    color: var(--accent);
  }

  .card-title {
    font-size: 1.45rem;
    font-weight: 700;
    color: var(--stage-text);
    line-height: 1.25;
  }

  .card-desc {
    font-size: 0.95rem;
    color: var(--stage-muted);
    line-height: 1.5;
  }

  @media (max-width: 900px) {
    .hero-topline {
      grid-template-columns: minmax(0, 1fr) minmax(190px, 0.48fr);
      gap: var(--space-6);
    }

    .hero-portrait {
      width: min(100%, 250px);
    }

    .audience-grid {
      grid-template-columns: 1fr;
    }
  }

  @media (max-width: 640px) {
    .hero-topline {
      grid-template-columns: 1fr;
    }

    .hero-portrait {
      justify-self: center;
      width: min(46vw, 190px);
      aspect-ratio: 0.9;
      padding: 6px;
      border-radius: 42% 42% var(--radius-card) var(--radius-card);
    }
  }
</style>
