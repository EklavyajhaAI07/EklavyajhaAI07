---
import Base from '../layouts/Base.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import ConnectSection from '../components/ConnectSection.astro';
import { identity, homePage } from '../lib/content';

const title = "Eklavya Jha | AI-Powered Full Stack Developer";
const description = "Eklavya Jha is an AI-powered full stack developer in Ahmedabad, learning AI engineering. Choose your path: recruiters, teams or clients.";
---

<Base
  title={title}
  description={description}
  canonicalPath="/"
  audience="home"
>
  <Header currentAudience="home" />

  <main id="main-content">
    <!-- Hero / Stage with 3 Audience Cards -->
    <section class="home-stage" aria-labelledby="home-heading">
      <div class="stage-inner container">
        <div class="hero-intro">
          <div class="identity-badge">
            <span class="pulse-dot"></span>
            <span>Based in {identity.location.city}, {identity.location.country}</span>
          </div>
          <h1 id="home-heading" class="display-title">
            {identity.name}, <span class="highlight">{identity.roleLine}</span>
          </h1>
          <p class="supporting-text">
            {identity.supportingLine} · Building real systems, full-stack applications, and multi-agent solutions.
          </p>
        </div>

        <!-- 3 Audience Route Cards -->
        <div class="audience-grid" role="region" aria-label="Choose your audience path">
          {homePage.cards.map((card) => (
            <a href={card.url} class="audience-card" id={`card-${card.id}`}>
              <div class="card-top">
                <span class="path-badge">Explore Path</span>
                <span class="card-arrow" aria-hidden="true">→</span>
              </div>
              <h2 class="card-title">{card.title}</h2>
              <p class="card-desc">{card.description}</p>
            </a>
          ))}
        </div>
      </div>
    </section>

    <!-- Connect & Forms Section -->
    <ConnectSection currentAudience="home" />
  </main>

  <Footer />
</Base>

<style>
  .home-stage {
    background-color: var(--stage-bg);
    color: var(--stage-text);
    padding: var(--space-12) 0 var(--space-16);
    position: relative;
    border-bottom: 1px solid rgba(255, 255, 255, 0.08);
  }

  .stage-inner {
    display: flex;
    flex-direction: column;
    gap: var(--space-10);
  }

  .hero-intro {
    max-width: 820px;
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
  }

  .identity-badge {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    font-size: 0.85rem;
    font-weight: 500;
    color: var(--stage-muted);
    background: rgba(255, 255, 255, 0.05);
    border: 1px solid rgba(255, 255, 255, 0.1);
    padding: 6px 14px;
    border-radius: var(--radius-pill);
    width: fit-content;
  }

  .pulse-dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background-color: #10B981;
    box-shadow: 0 0 8px #10B981;
  }

  .display-title {
    font-size: clamp(2rem, 5vw, 3.5rem);
    font-weight: 700;
    line-height: 1.15;
    letter-spacing: -0.02em;
    color: var(--stage-text);
  }

  .highlight {
    color: var(--accent);
  }

  .supporting-text {
    font-size: clamp(1.05rem, 2vw, 1.25rem);
    color: var(--stage-muted);
    line-height: 1.55;
    max-width: 680px;
  }

  .audience-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: var(--space-6);
  }

  .audience-card {
    background: rgba(255, 255, 255, 0.03);
    border: 1px solid rgba(255, 255, 255, 0.1);
    border-radius: var(--radius-md);
    padding: var(--space-8) var(--space-6);
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
    text-decoration: none;
    transition: all 0.25s ease;
    position: relative;
    overflow: hidden;
  }

  .audience-card::before {
    content: '';
    position: absolute;
    inset: 0;
    background: radial-gradient(circle at top right, rgba(59, 130, 246, 0.15), transparent 70%);
    opacity: 0;
    transition: opacity 0.3s ease;
  }

  .audience-card:hover {
    transform: translateY(-4px);
    border-color: var(--accent);
    background: rgba(255, 255, 255, 0.06);
    box-shadow: 0 12px 30px rgba(0, 0, 0, 0.3);
  }

  .audience-card:hover::before {
    opacity: 1;
  }

  .card-top {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: var(--space-2);
  }

  .path-badge {
    font-size: 0.75rem;
    font-weight: 600;
    color: var(--accent);
    text-transform: uppercase;
    letter-spacing: 0.06em;
  }

  .card-arrow {
    color: var(--stage-muted);
    font-size: 1.2rem;
    transition: transform 0.2s ease, color 0.2s ease;
  }

  .audience-card:hover .card-arrow {
    transform: translateX(4px);
    color: var(--accent);
  }

  .card-title {
    font-size: 1.45rem;
    font-weight: 700;
    color: var(--stage-text);
    line-height: 1.25;
  }

  .card-desc {
    font-size: 0.95rem;
    color: var(--stage-muted);
    line-height: 1.5;
  }

  @media (max-width: 900px) {
    .audience-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
