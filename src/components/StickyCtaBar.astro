---
// StickyCtaBar.astro
interface Props {
  currentAudience: 'recruiter' | 'teams' | 'clients' | 'home';
}

const { currentAudience } = Astro.props;

let ctaLabel = 'Connect with Eklavya';
let ctaHref = '#connect';
let isDownload = false;

if (currentAudience === 'recruiter') {
  ctaLabel = 'Download Resume (PDF)';
  ctaHref = '/assets/eklavya-jha-resume.pdf';
  isDownload = true;
} else if (currentAudience === 'teams') {
  ctaLabel = 'Connect to Collaborate';
  ctaHref = '#connect';
} else if (currentAudience === 'clients') {
  ctaLabel = 'Discuss Your Project';
  ctaHref = '#connect';
}
---

<div class="sticky-cta-bar" id="sticky-cta-bar" role="region" aria-label="Quick Action">
  <div class="container bar-inner">
    <div class="bar-info">
      <span class="bar-name">Eklavya Jha</span>
      <span class="bar-status">· Available for opportunities</span>
    </div>
    <div class="bar-actions">
      {isDownload ? (
        <a
          href={ctaHref}
          download="Eklavya_Jha_Resume.pdf"
          class="btn-bar-primary"
          id="sticky-btn-resume"
        >
          <span class="icon">📄</span>
          <span>{ctaLabel}</span>
        </a>
      ) : (
        <a href={ctaHref} class="btn-bar-primary">
          <span>{ctaLabel}</span>
          <span class="arrow" aria-hidden="true">→</span>
        </a>
      )}
    </div>
  </div>
</div>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    const bar = document.getElementById('sticky-cta-bar');
    const connectSec = document.getElementById('connect');
    if (!bar) return;

    // Show bar when animation completes or if animation already seen
    function showBar() {
      if (bar) bar.classList.add('visible');
    }

    window.addEventListener('eklavya:anim-completed', () => {
      showBar();
    });

    if (document.body.classList.contains('animation-finished')) {
      showBar();
    }

    // Hide sticky bar when scrolled down to the #connect section
    if (connectSec && 'IntersectionObserver' in window) {
      const observer = new IntersectionObserver(
        (entries) => {
          entries.forEach((entry) => {
            if (entry.isIntersecting) {
              bar.classList.remove('visible');
            } else if (document.body.classList.contains('animation-finished')) {
              bar.classList.add('visible');
            }
          });
        },
        { threshold: 0.1 }
      );
      observer.observe(connectSec);
    }
  });
</script>

<style>
  .sticky-cta-bar {
    position: fixed;
    bottom: 0;
    left: 0;
    width: 100%;
    z-index: 45;
    background: rgba(11, 13, 18, 0.92);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    border-top: 1px solid rgba(255, 255, 255, 0.12);
    padding: var(--space-3) 0;
    transform: translateY(100%);
    opacity: 0;
    pointer-events: none;
    transition: transform 0.3s cubic-bezier(0.16, 1, 0.3, 1), opacity 0.3s ease;
  }

  .sticky-cta-bar.visible {
    transform: translateY(0);
    opacity: 1;
    pointer-events: auto;
  }

  .bar-inner {
    display: flex;
    justify-content: space-between;
    align-items: center;
  }

  .bar-info {
    display: flex;
    align-items: center;
    gap: 6px;
    font-size: 0.88rem;
  }

  .bar-name {
    font-weight: 600;
    color: var(--stage-text);
  }

  .bar-status {
    color: var(--stage-muted);
  }

  .btn-bar-primary {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 8px 18px;
    background-color: var(--accent);
    color: #fff;
    font-size: 0.88rem;
    font-weight: 600;
    border-radius: var(--radius-button);
    text-decoration: none;
    box-shadow: 0 4px 14px rgba(59, 130, 246, 0.4);
    transition: all 0.2s ease;
  }

  .btn-bar-primary:hover {
    background-color: #2563EB;
    transform: translateY(-1px);
  }

  @media (max-width: 640px) {
    .bar-info {
      display: none;
    }
    .bar-inner {
      justify-content: center;
    }
    .btn-bar-primary {
      width: 100%;
      justify-content: center;
    }
  }
</style>
